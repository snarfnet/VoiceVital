// Param descriptions
"desc_f0" = "The fundamental pitch of vocal fold vibration. Under stress, sympathetic activation increases laryngeal muscle tension, raising F0.";
"desc_jitter" = "Cycle-to-cycle variation in vocal fold vibration period. Reflects fine neuromuscular control. Increases with fatigue, sleep deprivation, and aging. Normal: < 1.04%.";
"desc_shimmer" = "Cycle-to-cycle amplitude variation. Reflects vocal fold mass asymmetry and mucosal wave irregularity. Early indicator of vocal fatigue. Normal: < 3.81%.";
"desc_hnr" = "Ratio of periodic to aperiodic energy in voice. Quantitative index of breathy dysphonia from incomplete glottal closure. Normal: > 20 dB.";
"desc_cpp" = "Objective voice quality measure via cepstral analysis. The single strongest acoustic correlate of dysphonia severity.";
"desc_alpha" = "High/low spectral energy ratio at 1 kHz boundary. Under psychological stress, increased subglottal pressure raises high-frequency energy.";

